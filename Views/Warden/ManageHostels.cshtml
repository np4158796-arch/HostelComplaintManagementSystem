@model HostelComplaintManagementSystem.ViewModels.BlockManagementViewModel
@{
    ViewData["Title"] = "Hostel Blocks & Rooms Management";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-dark">Hostel Blocks & Rooms</h3>
        <p class="text-muted small mb-0">Manage residential wings, floors, and student room inventory.</p>
    </div>
</div>

<div class="row g-4">
    <!-- Blocks List and Add Block -->
    <div class="col-lg-5">
        <!-- Add Block Form -->
        <div class="card-custom bg-white p-4 mb-4 shadow-sm">
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-plus-circle text-violet me-2"></i>Add New Hostel Block</h6>
            <form asp-action="AddBlock" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">Block Name *</label>
                    <input type="text" name="NewBlockName" class="form-control" placeholder="e.g. Block D (Engineering Annex)" required />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary">Total Floors</label>
                    <input type="number" name="NewBlockFloors" value="4" min="1" max="10" class="form-control" />
                </div>
                <button type="submit" class="btn btn-sm btn-violet w-100 py-2">Create Hostel Block</button>
            </form>
        </div>

        <!-- Existing Blocks List -->
        <div class="card-custom bg-white p-4 shadow-sm">
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-buildings text-violet me-2"></i>Active Blocks (@Model.Blocks.Count())</h6>
            <div class="d-flex flex-column gap-2">
                @foreach (var b in Model.Blocks)
                {
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="text-dark">@b.Name</strong>
                            <span class="badge bg-secondary-subtle text-secondary">@b.TotalFloors Floors</span>
                        </div>
                        <div class="small text-muted">
                            <i class="bi bi-door-open me-1"></i>@(b.Rooms?.Count ?? 0) Rooms Configured
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Rooms Inventory and Add Room -->
    <div class="col-lg-7">
        <!-- Add Room Form -->
        <div class="card-custom bg-white p-4 mb-4 shadow-sm">
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-door-closed text-violet me-2"></i>Register New Room</h6>
            <form asp-action="AddRoom" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-2">
                    <div class="col-md-5">
                        <label class="form-label small fw-semibold text-secondary">Hostel Block *</label>
                        <select name="NewRoomBlockId" class="form-select form-select-sm" required>
                            @foreach (var block in Model.Blocks)
                            {
                                <option value="@block.Id">@block.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold text-secondary">Room No. *</label>
                        <input type="text" name="NewRoomNumber" class="form-control form-control-sm" placeholder="e.g. A-301" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold text-secondary">Floor</label>
                        <input type="number" name="NewRoomFloor" value="1" min="0" max="10" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold text-secondary">Capacity</label>
                        <input type="number" name="NewRoomCapacity" value="2" min="1" max="6" class="form-control form-control-sm" />
                    </div>
                </div>
                <div class="mt-3 text-end">
                    <button type="submit" class="btn btn-sm btn-navy text-white px-3 py-1">Add Room</button>
                </div>
            </form>
        </div>

        <!-- Rooms Inventory Table -->
        <div class="card-custom bg-white p-0 overflow-hidden shadow-sm">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-grid-3x3-gap text-violet me-2"></i>Configured Rooms (@Model.Rooms.Count())</h6>
            </div>
            <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Room Number</th>
                            <th>Hostel Block</th>
                            <th>Floor</th>
                            <th>Capacity</th>
                            <th>Occupancy</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Rooms)
                        {
                            <tr>
                                <td class="fw-bold text-dark font-monospace">@r.RoomNumber</td>
                                <td class="small text-secondary">@(r.HostelBlock?.Name ?? "Block")</td>
                                <td class="small">Floor @r.Floor</td>
                                <td class="small">@r.Capacity Beds</td>
                                <td>
                                    <span class="badge @(r.IsAvailable ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")">
                                        @r.CurrentOccupancy / @r.Capacity
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
