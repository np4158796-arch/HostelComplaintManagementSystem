@model HostelComplaintManagementSystem.ViewModels.WardenDashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Warden Administration Desk";
}

<!-- Top Executive Header -->
<div class="card-custom bg-gradient-navy text-white p-4 p-md-5 mb-4 shadow position-relative overflow-hidden">
    <div class="row align-items-center g-3 position-relative z-1">
        <div class="col-lg-7">
            <span class="badge bg-violet text-white px-3 py-1 rounded-pill small mb-2"><i class="bi bi-shield-shaded me-1"></i>Hostel Administration Desk</span>
            <h2 class="fw-bold mb-1">Chief Warden Oversight Portal</h2>
            <p class="text-white-50 mb-0">Monitor campus maintenance activities, allocate technicians, and enforce SLA resolution timelines.</p>
        </div>
        <div class="col-lg-5 text-lg-end d-flex flex-wrap gap-2 justify-content-lg-end">
            <a asp-action="ManageComplaints" class="btn btn-violet px-3 py-2 rounded-3 shadow-sm">
                <i class="bi bi-kanban me-1"></i>Manage Complaints
            </a>
            <a asp-controller="Reports" asp-action="Index" class="btn btn-outline-light px-3 py-2 rounded-3">
                <i class="bi bi-bar-chart-fill me-1"></i>Analytics
            </a>
            <a asp-action="ExportCsv" class="btn btn-navy-light text-white border border-secondary border-opacity-25 px-3 py-2 rounded-3" title="Export CSV Report">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i>Export CSV
            </a>
        </div>
    </div>
</div>

<!-- 5 KPI Metric Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card">
            <div class="text-muted small fw-semibold">Total Logged</div>
            <div class="fs-2 fw-bold text-dark mt-1">@Model.TotalComplaints</div>
            <div class="small text-muted mt-2"><i class="bi bi-folder2-open me-1"></i>All complaints</div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card">
            <div class="text-muted small fw-semibold">Pending Triage</div>
            <div class="fs-2 fw-bold text-warning-emphasis mt-1">@Model.PendingComplaints</div>
            <div class="small text-warning mt-2"><i class="bi bi-hourglass-split me-1"></i>Awaiting staff</div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card">
            <div class="text-muted small fw-semibold">In Progress</div>
            <div class="fs-2 fw-bold text-primary mt-1">@Model.InProgressComplaints</div>
            <div class="small text-primary mt-2"><i class="bi bi-tools me-1"></i>Active work</div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card">
            <div class="text-muted small fw-semibold">Resolved Cases</div>
            <div class="fs-2 fw-bold text-success mt-1">@Model.ResolvedComplaints</div>
            <div class="small text-success mt-2"><i class="bi bi-check2-all me-1"></i>Completed</div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card">
            <div class="text-muted small fw-semibold">Overdue (>3d)</div>
            <div class="fs-2 fw-bold text-danger mt-1">@Model.OverdueComplaints</div>
            <div class="small text-danger mt-2"><i class="bi bi-exclamation-triangle me-1"></i>SLA Breached</div>
        </div>
    </div>

    <div class="col-6 col-md-4 col-xl-2">
        <div class="stat-card border-danger">
            <div class="text-muted small fw-semibold text-danger">Urgent Priority</div>
            <div class="fs-2 fw-bold text-danger mt-1">@Model.UrgentComplaints</div>
            <div class="small text-danger mt-2"><i class="bi bi-fire me-1"></i>Immediate action</div>
        </div>
    </div>
</div>

<!-- Charts Section: Trends & Categories -->
<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <div class="card-custom bg-white p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-graph-up text-violet me-2"></i>Monthly Complaint Trends</h6>
                <span class="badge bg-light text-muted border">Last 6 Months</span>
            </div>
            <div style="height: 260px; position: relative;">
                <canvas id="monthlyTrendChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card-custom bg-white p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark mb-0"><i class="bi bi-bar-chart text-violet me-2"></i>Complaints by Category</h6>
                <span class="badge bg-light text-muted border">Distribution</span>
            </div>
            <div style="height: 260px; position: relative;">
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Urgent & Recent Complaints Tables -->
<div class="row g-4">
    <!-- Urgent Complaints -->
    <div class="col-lg-6">
        <div class="card-custom bg-white p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-danger mb-0">
                    <i class="bi bi-exclamation-octagon-fill text-danger me-2"></i>Urgent Open Complaints (@Model.UrgentComplaintsList.Count())
                </h6>
                <a asp-action="ManageComplaints" asp-route-Priority="Urgent" class="small text-danger text-decoration-none fw-semibold">View All Urgent &rarr;</a>
            </div>

            @if (!Model.UrgentComplaintsList.Any())
            {
                <div class="text-center py-4 text-muted small bg-light rounded-3">
                    <i class="bi bi-shield-check fs-2 text-success d-block mb-1"></i>
                    No urgent unattended complaints. Excellent!
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Ref & Title</th>
                                <th>Location</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.UrgentComplaintsList)
                            {
                                <tr>
                                    <td>
                                        <div class="font-monospace fw-semibold small text-dark">@c.ReferenceNumber</div>
                                        <div class="text-truncate small" style="max-width: 180px;" title="@c.Title">@c.Title</div>
                                    </td>
                                    <td class="small text-muted">
                                        @(c.HostelBlock?.Name?.Split(' ')[0] ?? "Block") - @c.RoomNumber
                                    </td>
                                    <td>
                                        <partial name="_StatusBadgePartial" model="c.Status" />
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Complaints" asp-action="Details" asp-route-id="@c.Id" class="btn btn-xs btn-outline-danger py-0 px-2 small">Manage</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Recent Audit Activity -->
    <div class="col-lg-6">
        <div class="card-custom bg-white p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold text-dark mb-0">
                    <i class="bi bi-clock-history text-violet me-2"></i>Recent Status Activities
                </h6>
                <a asp-action="ManageComplaints" class="small text-violet text-decoration-none">Manage All &rarr;</a>
            </div>

            @if (!Model.RecentActivities.Any())
            {
                <div class="text-center py-4 text-muted small">No recent activity.</div>
            }
            else
            {
                <div class="d-flex flex-column gap-2">
                    @foreach (var act in Model.RecentActivities)
                    {
                        <div class="p-2 rounded-2 border bg-light small">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-semibold text-dark">@act.Complaint?.ReferenceNumber</span>
                                <span class="text-muted" style="font-size:0.7rem;">@act.ChangedAt.ToString("MMM dd HH:mm")</span>
                            </div>
                            <div class="text-secondary small mt-1">
                                Status changed to <strong>@act.NewStatus</strong> by @(act.ChangedBy?.FullName ?? "System").
                                @if (!string.IsNullOrEmpty(act.Notes))
                                {
                                    <span class="text-muted fst-italic">(@act.Notes)</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // 1. Monthly Trends Line Chart
            const monthlyCtx = document.getElementById('monthlyTrendChart');
            if (monthlyCtx) {
                new Chart(monthlyCtx, {
                    type: 'line',
                    data: {
                        labels: @Html.Raw(JsonSerializer.Serialize(Model.MonthlyLabels)),
                        datasets: [{
                            label: 'Complaints Submitted',
                            data: @Html.Raw(JsonSerializer.Serialize(Model.MonthlyCounts)),
                            borderColor: '#6366f1',
                            backgroundColor: 'rgba(99, 102, 241, 0.1)',
                            fill: true,
                            tension: 0.35,
                            borderWidth: 2,
                            pointRadius: 4,
                            pointBackgroundColor: '#6366f1'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: { beginAtZero: true, ticks: { precision: 0 } }
                        }
                    }
                });
            }

            // 2. Category Distribution Bar Chart
            const catCtx = document.getElementById('categoryChart');
            if (catCtx) {
                new Chart(catCtx, {
                    type: 'bar',
                    data: {
                        labels: @Html.Raw(JsonSerializer.Serialize(Model.CategoryLabels)),
                        datasets: [{
                            label: 'Issues Count',
                            data: @Html.Raw(JsonSerializer.Serialize(Model.CategoryCounts)),
                            backgroundColor: ['#6366f1', '#10b981', '#f59e0b', '#06b6d4', '#ec4899', '#8b5cf6', '#64748b']
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, ticks: { precision: 0 } }
                        }
                    }
                });
            }
        });
    </script>
}
