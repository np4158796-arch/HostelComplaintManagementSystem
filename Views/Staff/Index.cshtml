@model HostelComplaintManagementSystem.ViewModels.StaffDashboardViewModel
@{
    ViewData["Title"] = "Maintenance Technician Dashboard";
}

<!-- Staff Welcome Header -->
<div class="card-custom bg-gradient-navy text-white p-4 p-md-5 mb-4 shadow position-relative overflow-hidden">
    <div class="row align-items-center g-3 position-relative z-1">
        <div class="col-lg-8">
            <span class="badge bg-warning text-dark px-3 py-1 rounded-pill small mb-2"><i class="bi bi-tools me-1"></i>Maintenance Operations</span>
            <h2 class="fw-bold mb-1">Technician Portal: @Model.StaffName</h2>
            <p class="text-white-50 mb-0">
                <i class="bi bi-envelope me-1"></i>@Model.StaffEmail &bull; 
                <span class="text-warning"><i class="bi bi-lightning-charge me-1"></i>@Model.UrgentTasks Urgent Task(s) Requiring Attention</span>
            </p>
        </div>
        <div class="col-lg-4 text-lg-end">
            <span class="badge bg-navy-light text-white border border-secondary border-opacity-25 px-3 py-2 fs-6">
                <i class="bi bi-check2-all text-success me-1"></i>@Model.CompletedTasks Tasks Completed
            </span>
        </div>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="text-muted small fw-semibold">Assigned Tasks</div>
            <div class="fs-2 fw-bold text-dark mt-1">@Model.TotalAssigned</div>
            <div class="small text-muted mt-2"><i class="bi bi-list-task me-1"></i>Total assigned to you</div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="text-muted small fw-semibold">In Progress</div>
            <div class="fs-2 fw-bold text-primary mt-1">@Model.InProgressTasks</div>
            <div class="small text-primary mt-2"><i class="bi bi-hammer me-1"></i>Active repairs</div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="stat-card border-danger">
            <div class="text-muted small fw-semibold text-danger">Urgent Tasks</div>
            <div class="fs-2 fw-bold text-danger mt-1">@Model.UrgentTasks</div>
            <div class="small text-danger mt-2"><i class="bi bi-exclamation-octagon me-1"></i>High priority</div>
        </div>
    </div>

    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="text-muted small fw-semibold">Completed</div>
            <div class="fs-2 fw-bold text-success mt-1">@Model.CompletedTasks</div>
            <div class="small text-success mt-2"><i class="bi bi-patch-check me-1"></i>Resolved tasks</div>
        </div>
    </div>
</div>

<!-- Active Assigned Tasks Section -->
<div class="card-custom bg-white p-4 mb-4 shadow-sm">
    <h5 class="fw-bold text-dark mb-3">
        <i class="bi bi-clipboard-check text-violet me-2"></i>Active Assigned Tasks (@Model.ActiveTasks.Count())
    </h5>

    @if (!Model.ActiveTasks.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-check-circle fs-1 text-success d-block mb-2"></i>
            <h6 class="fw-bold">All caught up!</h6>
            <p class="small">No pending maintenance tasks currently assigned to you.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Room Location</th>
                        <th>Issue Summary</th>
                        <th>Student Contact</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var task in Model.ActiveTasks)
                    {
                        <tr class="@(task.Priority == HostelComplaintManagementSystem.Models.ComplaintPriority.Urgent ? "table-danger bg-opacity-10" : "")">
                            <td>
                                <span class="badge bg-light text-dark border font-monospace">@task.ReferenceNumber</span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark"><i class="bi bi-door-closed me-1 text-violet"></i>@task.RoomNumber</div>
                                <div class="small text-muted">@(task.HostelBlock?.Name?.Split(' ')[0] ?? "Block")</div>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark text-truncate" style="max-width: 250px;" title="@task.Title">@task.Title</div>
                                <span class="small text-muted"><i class="bi bi-tag me-1"></i>@(task.Category?.Name ?? "General")</span>
                            </td>
                            <td>
                                <div class="small fw-semibold text-dark">@(task.Student?.FullName ?? "Student")</div>
                                @if (!string.IsNullOrEmpty(task.Student?.PhoneNumber))
                                {
                                    <a href="tel:@task.Student.PhoneNumber" class="small text-violet text-decoration-none">
                                        <i class="bi bi-telephone me-1"></i>@task.Student.PhoneNumber
                                    </a>
                                }
                            </td>
                            <td>
                                <partial name="_PriorityBadgePartial" model="task.Priority" />
                            </td>
                            <td>
                                <partial name="_StatusBadgePartial" model="task.Status" />
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-1">
                                    @if (task.Status == HostelComplaintManagementSystem.Models.ComplaintStatus.Assigned)
                                    {
                                        <form asp-action="AcceptTask" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="complaintId" value="@task.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary" title="Accept and start work">
                                                <i class="bi bi-play-fill me-1"></i>Accept
                                            </button>
                                        </form>
                                    }

                                    <button type="button" class="btn btn-sm btn-violet px-3" onclick="openStaffModal(@task.Id, '@task.ReferenceNumber', '@task.RoomNumber')">
                                        <i class="bi bi-pencil-square me-1"></i>Update
                                    </button>
                                    <a asp-controller="Complaints" asp-action="Details" asp-route-id="@task.Id" class="btn btn-sm btn-light" title="View History & Photos">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Completed Tasks History -->
<div class="card-custom bg-white p-4 shadow-sm">
    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-check2-circle text-success me-2"></i>Recently Completed Tasks</h6>
    @if (!Model.CompletedTasksList.Any())
    {
        <p class="text-muted small mb-0">No completed tasks yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Ref</th>
                        <th>Room</th>
                        <th>Title</th>
                        <th>Resolution Notes</th>
                        <th>Resolved Date</th>
                        <th class="text-end">Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.CompletedTasksList)
                    {
                        <tr>
                            <td><span class="font-monospace small">@t.ReferenceNumber</span></td>
                            <td class="small fw-semibold">@t.RoomNumber</td>
                            <td class="small text-truncate" style="max-width: 220px;">@t.Title</td>
                            <td class="small text-muted">@(string.IsNullOrEmpty(t.ResolutionNotes) ? "Completed by technician." : t.ResolutionNotes)</td>
                            <td class="small text-muted">@(t.ResolvedAt?.ToString("MMM dd HH:mm") ?? "N/A")</td>
                            <td class="text-end">
                                <a asp-controller="Complaints" asp-action="Details" asp-route-id="@t.Id" class="btn btn-xs btn-outline-secondary py-0 px-2 small">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Staff Update Progress Modal -->
<div class="modal fade" id="staffUpdateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="UpdateProgress" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="staffComplaintId" name="complaintId" />

                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Update Task <span id="staffRefText" class="text-violet font-monospace"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="p-2 bg-light rounded-2 mb-3 small">
                        <strong>Location:</strong> Room <span id="staffRoomText" class="fw-bold text-dark"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Work Status *</label>
                        <select name="newStatus" class="form-select" required>
                            <option value="@HostelComplaintManagementSystem.Models.ComplaintStatus.InProgress">In Progress (Work Ongoing)</option>
                            <option value="@HostelComplaintManagementSystem.Models.ComplaintStatus.Resolved">Resolved (Work Completed Successfully)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Progress Notes / Parts Used</label>
                        <textarea name="notes" rows="2" class="form-control" placeholder="e.g. Replaced capacitor, tightened loose contacts..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Resolution Notes (If Marking Resolved)</label>
                        <textarea name="resolutionNotes" rows="2" class="form-control" placeholder="Final summary of resolved issue for student and warden sign-off..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-violet">Save Progress</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openStaffModal(complaintId, refNumber, roomNumber) {
            document.getElementById('staffComplaintId').value = complaintId;
            document.getElementById('staffRefText').innerText = refNumber;
            document.getElementById('staffRoomText').innerText = roomNumber;
            const modal = new bootstrap.Modal(document.getElementById('staffUpdateModal'));
            modal.show();
        }
    </script>
}
