@model HostelComplaintManagementSystem.ViewModels.ComplaintCreateViewModel
@{
    ViewData["Title"] = "Submit Hostel Complaint";
}

<div class="row justify-content-center py-3">
    <div class="col-lg-9">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-2">
                    <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
                </a>
                <h3 class="fw-bold mb-1 text-dark">Submit a New Complaint</h3>
                <p class="text-muted small mb-0">Fill in the details below. Our maintenance team will be notified immediately.</p>
            </div>
            <span class="badge bg-violet text-white px-3 py-2 rounded-pill"><i class="bi bi-shield-lock me-1"></i>Official Redressal</span>
        </div>

        <div class="card-custom bg-white p-4 p-md-5 shadow-sm border">
            <form asp-action="SubmitComplaint" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <!-- Complaint Title -->
                <div class="mb-4">
                    <label asp-for="Title" class="form-label fw-semibold text-secondary small"></label>
                    <input asp-for="Title" class="form-control form-control-lg fs-6" placeholder="Brief summary of the issue (e.g. Washroom tap leaking, Fan not rotating)" />
                    <div class="form-text small text-muted">Keep the title concise and descriptive.</div>
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-4">
                    <!-- Category Selector -->
                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label fw-semibold text-secondary small"></label>
                        <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                            <option value="">-- Choose Category --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <!-- Priority Selector -->
                    <div class="col-md-6">
                        <label asp-for="Priority" class="form-label fw-semibold text-secondary small"></label>
                        <select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<HostelComplaintManagementSystem.Models.ComplaintPriority>()">
                        </select>
                        <span asp-validation-for="Priority" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Hostel Block & Room (Auto-populated from Student Profile) -->
                <div class="p-3 bg-light rounded-3 border mb-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="BlockId" class="form-label fw-semibold text-secondary small"></label>
                            <select asp-for="BlockId" asp-items="Model.Blocks" class="form-select">
                            </select>
                            <span asp-validation-for="BlockId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="RoomNumber" class="form-label fw-semibold text-secondary small"></label>
                            <input asp-for="RoomNumber" class="form-control" placeholder="e.g. A-204" />
                            <span asp-validation-for="RoomNumber" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="small text-muted mt-2">
                        <i class="bi bi-info-circle me-1"></i>Block and Room are prefilled from your account. You may adjust them if reporting for a common area or shared washroom.
                    </div>
                </div>

                <!-- Detailed Description -->
                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-semibold text-secondary small"></label>
                    <textarea asp-for="Description" rows="5" class="form-control" placeholder="Provide complete specifics: when did it start, exact location, observable damage, any safety hazards..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <!-- Optional Evidence Photo Upload -->
                <div class="mb-4">
                    <label asp-for="ImageFile" class="form-label fw-semibold text-secondary small"></label>
                    <input asp-for="ImageFile" type="file" class="form-control" id="imageFileInput" accept=".jpg,.jpeg,.png,.webp" />
                    <div class="form-text small text-muted">Allowed formats: JPG, JPEG, PNG, WEBP. Maximum file size: 5MB.</div>
                    <span asp-validation-for="ImageFile" class="text-danger small"></span>

                    <!-- Image Preview Container (site.js preview handler) -->
                    <div id="imagePreviewContainer" class="mt-3 d-none">
                        <p class="small text-secondary mb-1">Uploaded Evidence Preview:</p>
                        <img id="imagePreview" src="#" alt="Evidence Preview" class="img-thumbnail rounded-3 shadow-xs" style="max-height: 220px; object-fit: contain;" />
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                    <button type="submit" class="btn btn-violet px-4 py-2 rounded-3 fw-semibold">
                        <i class="bi bi-send-fill me-2"></i>Register Complaint
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
