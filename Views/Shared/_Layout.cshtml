@inject HostelComplaintManagementSystem.Services.INotificationService NotificationService
@inject Microsoft.AspNetCore.Identity.UserManager<HostelComplaintManagementSystem.Models.ApplicationUser> UserManager

@{
    var currentUserId = UserManager.GetUserId(User);
    int unreadNotifications = 0;
    if (!string.IsNullOrEmpty(currentUserId))
    {
        unreadNotifications = await NotificationService.GetUnreadCountAsync(currentUserId);
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " - " : "")HostelCare | Hostel Complaint Management System</title>
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <!-- Custom Theme Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <!-- Top Announcement Bar -->
    <div class="bg-dark text-white py-1 px-3 small border-bottom border-secondary border-opacity-25 d-none d-md-block">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                <span class="badge bg-primary-subtle text-primary me-2">IT5039</span>
                <span>Web Technology with .NET — University College Hostel System</span>
            </div>
            <div class="d-flex gap-3 text-secondary">
                <span><i class="bi bi-clock me-1"></i>24/7 Hostel Assistance</span>
                <span><i class="bi bi-shield-check me-1"></i>Secure Campus Portal</span>
            </div>
        </div>
    </div>

    <!-- Main Navigation Bar -->
    <header class="sticky-top shadow-sm">
        <nav class="navbar navbar-expand-lg navbar-dark bg-navy">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon bg-gradient-violet text-white rounded-3 d-flex align-items-center justify-content-center">
                        <i class="bi bi-building-check fs-4"></i>
                    </div>
                    <div>
                        <span class="fw-bold fs-4 tracking-tight text-white">HostelCare</span>
                        <div class="small text-violet-subtle d-none d-sm-block lh-1" style="font-size: 0.72rem;">Your Complaint. Our Responsibility.</div>
                    </div>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-dismiss="collapse" data-bs-target="#navbarMain" aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Complaints" asp-action="Track"><i class="bi bi-search me-1"></i>Track Complaint</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="PaymentDemo" asp-action="Index"><i class="bi bi-credit-card me-1"></i>Fee Demo</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="About"><i class="bi bi-info-circle me-1"></i>About</a>
                        </li>

                        @if (User.IsInRole("Student"))
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-semibold text-warning" asp-controller="Student" asp-action="Index"><i class="bi bi-speedometer2 me-1"></i>My Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Student" asp-action="SubmitComplaint"><i class="bi bi-plus-circle me-1"></i>Submit Complaint</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Student" asp-action="MyComplaints"><i class="bi bi-list-task me-1"></i>My Complaints</a>
                            </li>
                        }
                        else if (User.IsInRole("Warden"))
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-semibold text-warning" asp-controller="Warden" asp-action="Index"><i class="bi bi-shield-lock me-1"></i>Warden Desk</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Warden" asp-action="ManageComplaints"><i class="bi bi-kanban me-1"></i>Manage Complaints</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Reports" asp-action="Index"><i class="bi bi-graph-up-arrow me-1"></i>Reports</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-info" href="/swagger" target="_blank"><i class="bi bi-code-slash me-1"></i>Swagger API</a>
                            </li>
                        }
                        else if (User.IsInRole("MaintenanceStaff"))
                        {
                            <li class="nav-item">
                                <a class="nav-link fw-semibold text-warning" asp-controller="Staff" asp-action="Index"><i class="bi bi-tools me-1"></i>Staff Tasks</a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <!-- Notification Center Bell -->
                            <a class="btn btn-outline-light position-relative border-0 rounded-circle p-2" asp-controller="Notifications" asp-action="Index" title="Notifications">
                                <i class="bi bi-bell fs-5"></i>
                                @if (unreadNotifications > 0)
                                {
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                        @unreadNotifications
                                        <span class="visually-hidden">unread messages</span>
                                    </span>
                                }
                            </a>

                            <!-- User Profile Dropdown -->
                            <div class="dropdown">
                                <button class="btn btn-navy-light text-white dropdown-toggle d-flex align-items-center gap-2 border-0 rounded-3 px-3 py-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="avatar-circle bg-violet text-white">
                                        @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                                    </div>
                                    <span class="small fw-medium d-none d-sm-inline">@User.Identity.Name</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                    <li class="dropdown-header">
                                        <div class="fw-bold text-dark">Signed in as</div>
                                        <div class="small text-muted">@User.Identity.Name</div>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person me-2"></i>My Profile</a></li>
                                    <li><a class="dropdown-item" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell me-2"></i>Notifications (@unreadNotifications)</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a class="btn btn-outline-light rounded-3 px-3" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Login
                            </a>
                            <a class="btn btn-violet rounded-3 px-3 shadow-sm" asp-controller="Account" asp-action="Register">
                                <i class="bi bi-person-plus me-1"></i>Register
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Area -->
    <main role="main" class="flex-grow-1">
        <div class="container py-4">
            <partial name="_AlertMessages" />
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-navy text-white mt-auto pt-5 pb-3 border-top border-secondary border-opacity-25">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="brand-icon bg-gradient-violet text-white rounded-3 d-flex align-items-center justify-content-center p-2">
                            <i class="bi bi-building-check fs-4"></i>
                        </div>
                        <span class="fs-4 fw-bold text-white">HostelCare</span>
                    </div>
                    <p class="text-white-50 small mb-3">
                        A robust, responsive college hostel grievance redressal and maintenance management system built for seamless student-warden-technician collaboration.
                    </p>
                    <div class="d-flex gap-2">
                        <span class="badge bg-dark border border-secondary text-white-50 p-2"><i class="bi bi-shield-lock me-1"></i>Role-Based Security</span>
                        <span class="badge bg-dark border border-secondary text-white-50 p-2"><i class="bi bi-lightning-charge me-1"></i>Real-Time Auditing</span>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h6 class="text-uppercase fw-bold text-violet-subtle mb-3">Portals</h6>
                    <ul class="list-unstyled small mb-0 d-flex flex-column gap-2">
                        <li><a class="text-white-50 text-decoration-none hover-white" asp-controller="Account" asp-action="Login"><i class="bi bi-chevron-right me-1"></i>Student Login</a></li>
                        <li><a class="text-white-50 text-decoration-none hover-white" asp-controller="Account" asp-action="Register"><i class="bi bi-chevron-right me-1"></i>Registration</a></li>
                        <li><a class="text-white-50 text-decoration-none hover-white" asp-controller="Account" asp-action="Login"><i class="bi bi-chevron-right me-1"></i>Warden Office</a></li>
                        <li><a class="text-white-50 text-decoration-none hover-white" asp-controller="Account" asp-action="Login"><i class="bi bi-chevron-right me-1"></i>Staff Desk</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="text-uppercase fw-bold text-violet-subtle mb-3">Academic Project</h6>
                    <p class="text-white-50 small mb-2"><strong>Subject:</strong> IT5039 – Web Technology with .NET</p>
                    <p class="text-white-50 small mb-2"><strong>Target:</strong> B.Tech Computer Engineering</p>
                    <p class="text-white-50 small mb-0"><strong>Stack:</strong> ASP.NET Core 8 MVC, EF Core, SQL Server LocalDB, Identity, Bootstrap 5, Chart.js</p>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="text-uppercase fw-bold text-violet-subtle mb-3">Emergency & Desk</h6>
                    <ul class="list-unstyled small text-white-50 d-flex flex-column gap-2">
                        <li><i class="bi bi-telephone-fill me-2 text-warning"></i>Helpline: +91 (020) 2590-7800</li>
                        <li><i class="bi bi-envelope-fill me-2 text-info"></i>Email: warden@hostelcare.com</li>
                        <li><i class="bi bi-geo-alt-fill me-2 text-danger"></i>Hostel Care Office, Campus North Wing</li>
                    </ul>
                </div>
            </div>

            <hr class="border-secondary border-opacity-25" />

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center small text-white-50 gap-2">
                <div>
                    &copy; @DateTime.UtcNow.Year HostelCare. Built for IT5039 Viva & College Demonstration.
                </div>
                <div class="d-flex gap-3">
                    <a class="text-white-50 text-decoration-none hover-white" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                    <a class="text-white-50 text-decoration-none hover-white" asp-controller="Home" asp-action="About">About Project</a>
                    <a class="text-white-50 text-decoration-none hover-white" href="/swagger" target="_blank">Swagger OpenAPI</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
    <!-- Site Script -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
