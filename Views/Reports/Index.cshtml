@model HostelComplaintManagementSystem.ViewModels.ReportFilterViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Analytical Reports & SLA Performance";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-dark">Hostel Analytical Reports</h3>
        <p class="text-muted small mb-0">Evaluate resolution velocity, staff workload balance, and chronic infrastructure complaints.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="DownloadCsv" asp-route-startDate="@ViewBag.StartDate" asp-route-endDate="@ViewBag.EndDate" asp-route-categoryId="@Model.CategoryId" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i>Download Full CSV
        </a>
    </div>
</div>

<!-- Date Filter Form -->
<div class="card-custom bg-white p-3 mb-4 shadow-sm">
    <form asp-action="Index" method="get">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary">Start Date</label>
                <input type="date" name="startDate" value="@ViewBag.StartDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary">End Date</label>
                <input type="date" name="endDate" value="@ViewBag.EndDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary">Filter by Category</label>
                <select name="categoryId" asp-items="ViewBag.Categories" class="form-select form-select-sm">
                    <option value="">All Categories</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-1">
                <button type="submit" class="btn btn-navy btn-sm flex-grow-1 text-white"><i class="bi bi-funnel me-1"></i>Filter Reports</button>
                <a asp-action="Index" class="btn btn-light btn-sm"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </div>
    </form>
</div>

<!-- High-Level KPI Summary -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="text-muted small fw-semibold">Total Complaints</div>
            <div class="fs-2 fw-bold text-dark mt-1">@Model.Summary.TotalComplaints</div>
            <div class="small text-muted mt-2">In selected period</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="text-muted small fw-semibold">Resolved Cases</div>
            <div class="fs-2 fw-bold text-success mt-1">@Model.Summary.ResolvedComplaints</div>
            <div class="small text-success mt-2">@Model.Summary.ResolutionRatePercentage% resolution rate</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="text-muted small fw-semibold">Pending / Active</div>
            <div class="fs-2 fw-bold text-warning-emphasis mt-1">@Model.Summary.PendingComplaints</div>
            <div class="small text-warning mt-2">In progress or triage</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="text-muted small fw-semibold">Average Resolution Time</div>
            <div class="fs-2 fw-bold text-violet mt-1">@Model.Summary.AverageResolutionHours <span class="fs-6 fw-normal text-muted">hrs</span></div>
            <div class="small text-muted mt-2">From submission to close</div>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card-custom bg-white p-4 h-100">
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-pie-chart text-violet me-2"></i>Issues by Category (%)</h6>
            <div style="height: 250px; position: relative;">
                <canvas id="repCategoryChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card-custom bg-white p-4 h-100">
            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-bar-chart-steps text-violet me-2"></i>Priority Distribution</h6>
            <div style="height: 250px; position: relative;">
                <canvas id="repPriorityChart"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Staff Workload and Completion Statistics Table -->
<div class="card-custom bg-white p-0 overflow-hidden shadow-sm mb-4">
    <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-person-gear text-violet me-2"></i>Staff Workload & Performance Scorecard</h6>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Technician Name</th>
                    <th>Email Address</th>
                    <th>Total Assigned</th>
                    <th>Completed</th>
                    <th>Pending</th>
                    <th>Avg Hours to Complete</th>
                    <th>Efficiency</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var staff in Model.Summary.StaffPerformance)
                {
                    var eff = staff.TotalAssigned > 0 ? Math.Round((double)staff.Completed / staff.TotalAssigned * 100, 1) : 0;
                    <tr>
                        <td class="fw-bold text-dark"><i class="bi bi-person-check text-primary me-2"></i>@staff.StaffName</td>
                        <td class="small text-secondary">@staff.Email</td>
                        <td class="small fw-semibold">@staff.TotalAssigned</td>
                        <td><span class="badge bg-success-subtle text-success">@staff.Completed</span></td>
                        <td><span class="badge bg-warning-subtle text-warning-emphasis">@staff.Pending</span></td>
                        <td class="small">@(staff.AverageHoursToComplete > 0 ? $"{staff.AverageHoursToComplete} hrs" : "N/A")</td>
                        <td>
                            <div class="progress" style="height: 8px; width: 100px;">
                                <div class="progress-bar bg-violet" role="progressbar" style="width: @eff%" aria-valuenow="@eff" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <span class="small text-muted" style="font-size:0.75rem;">@eff%</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Category Doughnut Chart
            const catLabels = @Html.Raw(JsonSerializer.Serialize(Model.Summary.CategoryStats.Select(c => c.CategoryName)));
            const catCounts = @Html.Raw(JsonSerializer.Serialize(Model.Summary.CategoryStats.Select(c => c.Count)));

            const catCtx = document.getElementById('repCategoryChart');
            if (catCtx) {
                new Chart(catCtx, {
                    type: 'doughnut',
                    data: {
                        labels: catLabels,
                        datasets: [{
                            data: catCounts,
                            backgroundColor: ['#6366f1', '#10b981', '#f59e0b', '#06b6d4', '#ec4899', '#8b5cf6', '#64748b']
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'right', labels: { boxWidth: 12 } } }
                    }
                });
            }

            // Priority Bar Chart
            const prioLabels = @Html.Raw(JsonSerializer.Serialize(Model.Summary.PriorityStats.Select(p => p.PriorityName)));
            const prioCounts = @Html.Raw(JsonSerializer.Serialize(Model.Summary.PriorityStats.Select(p => p.Count)));

            const prioCtx = document.getElementById('repPriorityChart');
            if (prioCtx) {
                new Chart(prioCtx, {
                    type: 'bar',
                    data: {
                        labels: prioLabels,
                        datasets: [{
                            label: 'Complaints',
                            data: prioCounts,
                            backgroundColor: ['#94a3b8', '#06b6d4', '#f59e0b', '#ef4444']
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                    }
                });
            }
        });
    </script>
}
