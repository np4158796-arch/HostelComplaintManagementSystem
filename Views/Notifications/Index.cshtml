@model IEnumerable<HostelComplaintManagementSystem.Models.Notification>
@{
    ViewData["Title"] = "Notification Center";
}

<div class="row justify-content-center py-3">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-1 text-dark">Notification Center</h3>
                <p class="text-muted small mb-0">Stay informed on assignments, technician status transitions, and announcements.</p>
            </div>
            @if (Model.Any(n => !n.IsRead))
            {
                <form asp-action="MarkAllAsRead" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-violet">
                        <i class="bi bi-check2-all me-1"></i>Mark All as Read
                    </button>
                </form>
            }
        </div>

        <div class="card-custom bg-white p-4 shadow-sm">
            @if (!Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-bell-slash fs-1 text-secondary mb-2 d-block"></i>
                    <h6 class="fw-bold">No notifications yet</h6>
                    <p class="small">When your complaint is assigned or updated, notices will appear here.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var n in Model)
                    {
                        <div class="p-3 rounded-3 border @(n.IsRead ? "bg-light" : "bg-violet-subtle border-violet") position-relative">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <div class="d-flex align-items-center gap-2">
                                    @switch (n.Type)
                                    {
                                        case HostelComplaintManagementSystem.Models.NotificationType.ComplaintResolved:
                                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                            break;
                                        case HostelComplaintManagementSystem.Models.NotificationType.ComplaintAssigned:
                                            <i class="bi bi-person-check-fill text-info fs-5"></i>
                                            break;
                                        case HostelComplaintManagementSystem.Models.NotificationType.StatusUpdated:
                                            <i class="bi bi-arrow-repeat text-primary fs-5"></i>
                                            break;
                                        default:
                                            <i class="bi bi-bell-fill text-warning fs-5"></i>
                                            break;
                                    }
                                    <strong class="text-dark">@n.Title</strong>
                                    @if (!n.IsRead)
                                    {
                                        <span class="badge bg-violet text-white" style="font-size:0.65rem;">New</span>
                                    }
                                </div>
                                <span class="text-muted small" style="font-size: 0.75rem;">@n.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                            </div>

                            <p class="small text-secondary mb-2 ps-4">@n.Message</p>

                            <div class="d-flex justify-content-between align-items-center ps-4 pt-1">
                                @if (n.ComplaintId.HasValue)
                                {
                                    <a asp-controller="Complaints" asp-action="Details" asp-route-id="@n.ComplaintId.Value" class="small fw-semibold text-violet text-decoration-none">
                                        View Complaint &rarr;
                                    </a>
                                }
                                else
                                {
                                    <span></span>
                                }

                                @if (!n.IsRead)
                                {
                                    <form asp-action="MarkAsRead" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@n.Id" />
                                        <button type="submit" class="btn btn-xs btn-outline-secondary py-0 px-2 small" style="font-size:0.75rem;">
                                            Mark as read
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
