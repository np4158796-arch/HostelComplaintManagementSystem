@{
    ViewData["Title"] = "Page Not Found (404)";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-5 text-center">
        <div class="card-custom bg-white p-5 shadow-sm border">
            <div class="display-1 text-warning mb-3"><i class="bi bi-question-circle-fill"></i></div>
            <h3 class="fw-bold text-dark mb-2">404 - Page Not Found</h3>
            <p class="text-muted small mb-4">
                The requested page or complaint reference could not be located on the server.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-violet">Return to Homepage</a>
                <a asp-controller="Complaints" asp-action="Track" class="btn btn-outline-secondary">Lookup Reference</a>
            </div>
        </div>
    </div>
</div>
