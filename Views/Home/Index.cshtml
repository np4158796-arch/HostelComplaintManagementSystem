@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="py-5 bg-gradient-hero rounded-4 text-white p-4 p-md-5 mb-5 shadow-lg position-relative overflow-hidden">
    <div class="row align-items-center position-relative z-1 g-4">
        <div class="col-lg-7">
            <span class="badge bg-violet text-white px-3 py-2 rounded-pill mb-3 fw-semibold shadow-sm">
                <i class="bi bi-shield-check me-1"></i>Official College Hostel Redressal System
            </span>
            <h1 class="display-4 fw-extrabold tracking-tight mb-3 lh-sm">
                A Better Hostel Starts with a <span class="text-violet-subtle">Better Solution.</span>
            </h1>
            <p class="lead text-light text-opacity-90 mb-4 fs-5" style="max-width: 580px;">
                HostelCare streamlines repair requests, room maintenance, and grievance reporting across all hostel blocks. Transparent tracking from submission to technician sign-off.
            </p>
            <div class="d-flex flex-wrap gap-3">
                <a asp-controller="Account" asp-action="Login" class="btn btn-violet btn-lg px-4 py-2 rounded-3 shadow">
                    <i class="bi bi-send me-2"></i>Submit a Complaint
                </a>
                <a asp-controller="Complaints" asp-action="Track" class="btn btn-outline-light btn-lg px-4 py-2 rounded-3">
                    <i class="bi bi-search me-2"></i>Track Your Complaint
                </a>
            </div>
            <div class="mt-4 pt-2 d-flex align-items-center gap-4 text-light text-opacity-75 small">
                <span><i class="bi bi-check-circle-fill text-success me-1"></i>24/7 Logging</span>
                <span><i class="bi bi-check-circle-fill text-success me-1"></i>Auto Escalation</span>
                <span><i class="bi bi-check-circle-fill text-success me-1"></i>Photo Evidence</span>
            </div>
        </div>
        <div class="col-lg-5 text-center">
            <div class="bg-navy-surface p-4 rounded-4 border border-secondary border-opacity-25 shadow-lg text-start">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom border-secondary border-opacity-25">
                    <span class="fw-bold text-white"><i class="bi bi-activity text-violet me-2"></i>Live System Metrics</span>
                    <span class="badge bg-success-subtle text-success"><i class="bi bi-dot"></i>Active</span>
                </div>
                <div class="row g-3">
                    <div class="col-6">
                        <div class="bg-navy p-3 rounded-3 border border-secondary border-opacity-25">
                            <div class="text-white-50 small">Total Logged</div>
                            <div class="fs-3 fw-bold text-white">@(ViewBag.TotalComplaints ?? 0)</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="bg-navy p-3 rounded-3 border border-secondary border-opacity-25">
                            <div class="text-white-50 small">Resolved Cases</div>
                            <div class="fs-3 fw-bold text-success">@(ViewBag.ResolvedComplaints ?? 0)</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="bg-navy p-3 rounded-3 border border-secondary border-opacity-25">
                            <div class="text-white-50 small">Rooms Covered</div>
                            <div class="fs-3 fw-bold text-info">@(ViewBag.TotalRooms ?? 0)</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="bg-navy p-3 rounded-3 border border-secondary border-opacity-25">
                            <div class="text-white-50 small">Categories</div>
                            <div class="fs-3 fw-bold text-warning">@(ViewBag.TotalCategories ?? 10)</div>
                        </div>
                    </div>
                </div>
                <div class="mt-3 text-center">
                    <a asp-controller="Complaints" asp-action="Track" class="small text-violet-subtle text-decoration-none">
                        Have a Reference ID? Look up status &rarr;
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 3-Step Process -->
<section class="py-4 mb-5">
    <div class="text-center mb-5">
        <span class="text-violet fw-bold text-uppercase small tracking-wide">Streamlined Redressal</span>
        <h2 class="fw-bold fs-2 mt-1">How HostelCare Works</h2>
        <p class="text-muted" style="max-width: 600px; margin: 0 auto;">
            A simple, transparent 3-step lifecycle ensuring accountability between students, hostel wardens, and maintenance teams.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card-custom h-100 p-4 text-center">
                <div class="stat-icon-wrapper bg-violet-subtle text-violet mx-auto mb-3 fs-3">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <h5 class="fw-bold mb-2">1. Register Complaint</h5>
                <p class="text-muted small mb-0">
                    Log in with your student credentials, select the problem category (electrical, plumbing, Wi-Fi, etc.), describe the issue, and attach optional photo evidence.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-custom h-100 p-4 text-center">
                <div class="stat-icon-wrapper bg-warning-subtle text-warning-emphasis mx-auto mb-3 fs-3">
                    <i class="bi bi-person-gear"></i>
                </div>
                <h5 class="fw-bold mb-2">2. Warden Review & Assign</h5>
                <p class="text-muted small mb-0">
                    Hostel administrators triage incoming complaints, evaluate urgency, and assign dedicated maintenance technicians with room-specific instructions.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-custom h-100 p-4 text-center">
                <div class="stat-icon-wrapper bg-success-subtle text-success mx-auto mb-3 fs-3">
                    <i class="bi bi-check2-circle"></i>
                </div>
                <h5 class="fw-bold mb-2">3. Repair & Verification</h5>
                <p class="text-muted small mb-0">
                    The assigned technician resolves the issue on site, logs completion notes, and marks it resolved. Students receive notifications and can reopen if unsatisfied.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Features & Categories Grid -->
<section class="py-4 mb-5">
    <div class="card-custom p-4 p-md-5 bg-white border-0 shadow-sm">
        <div class="row align-items-center g-4 mb-4">
            <div class="col-lg-6">
                <h3 class="fw-bold mb-2">Comprehensive Issue Coverage</h3>
                <p class="text-muted mb-0">
                    From emergency electrical faults to daily hygiene, HostelCare covers every facet of student residential life.
                </p>
            </div>
            <div class="col-lg-6 text-lg-end">
                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-violet">
                    <i class="bi bi-person-plus me-1"></i>Create Student Account
                </a>
            </div>
        </div>

        <div class="row row-cols-2 row-cols-md-5 g-3 text-center">
            <div class="col">
                <div class="p-3 rounded-3 bg-light border border-light-subtle h-100">
                    <i class="bi bi-lightning-charge fs-2 text-warning mb-2 d-block"></i>
                    <span class="small fw-semibold">Electrical</span>
                </div>
            </div>
            <div class="col">
                <div class="p-3 rounded-3 bg-light border border-light-subtle h-100">
                    <i class="bi bi-droplet-half fs-2 text-info mb-2 d-block"></i>
                    <span class="small fw-semibold">Plumbing</span>
                </div>
            </div>
            <div class="col">
                <div class="p-3 rounded-3 bg-light border border-light-subtle h-100">
                    <i class="bi bi-stars fs-2 text-primary mb-2 d-block"></i>
                    <span class="small fw-semibold">Hygiene</span>
                </div>
            </div>
            <div class="col">
                <div class="p-3 rounded-3 bg-light border border-light-subtle h-100">
                    <i class="bi bi-wifi fs-2 text-success mb-2 d-block"></i>
                    <span class="small fw-semibold">Wi-Fi & LAN</span>
                </div>
            </div>
            <div class="col">
                <div class="p-3 rounded-3 bg-light border border-light-subtle h-100">
                    <i class="bi bi-lamp fs-2 text-secondary mb-2 d-block"></i>
                    <span class="small fw-semibold">Furniture</span>
                </div>
            </div>
            <div class="col">
                <div class="p-3 rounded-3 bg-light border border-light-subtle h-100">
                    <i class="bi bi-cup-straw fs-2 text-info mb-2 d-block"></i>
                    <span class="small fw-semibold">Water Supply</span>
                </div>
            </div>
            <div class="col">
                <div class="p-3 rounded-3 bg-light border border-light-subtle h-100">
                    <i class="bi bi-door-closed fs-2 text-dark mb-2 d-block"></i>
                    <span class="small fw-semibold">Room Repair</span>
                </div>
            </div>
            <div class="col">
                <div class="p-3 rounded-3 bg-light border border-light-subtle h-100">
                    <i class="bi bi-shield-exclamation fs-2 text-danger mb-2 d-block"></i>
                    <span class="small fw-semibold">Security</span>
                </div>
            </div>
            <div class="col">
                <div class="p-3 rounded-3 bg-light border border-light-subtle h-100">
                    <i class="bi bi-cup-hot fs-2 text-danger mb-2 d-block"></i>
                    <span class="small fw-semibold">Mess & Dining</span>
                </div>
            </div>
            <div class="col">
                <div class="p-3 rounded-3 bg-light border border-light-subtle h-100">
                    <i class="bi bi-three-dots fs-2 text-muted mb-2 d-block"></i>
                    <span class="small fw-semibold">Other Queries</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action Banner -->
<section class="p-4 p-md-5 bg-navy text-white rounded-4 text-center shadow">
    <h3 class="fw-bold mb-3">Ready to report a maintenance concern?</h3>
    <p class="text-white-50 mb-4" style="max-width: 620px; margin: 0 auto;">
        Log in to access your personal student portal, view real-time status updates, and stay notified on every step of your repair request.
    </p>
    <div class="d-flex justify-content-center gap-3">
        <a asp-controller="Account" asp-action="Login" class="btn btn-violet btn-lg px-4">
            <i class="bi bi-box-arrow-in-right me-1"></i>Sign In to Portal
        </a>
        <a asp-controller="Complaints" asp-action="Track" class="btn btn-outline-light btn-lg px-4">
            <i class="bi bi-search me-1"></i>Track by Reference ID
        </a>
    </div>
</section>
