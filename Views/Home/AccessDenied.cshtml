@{
    ViewData["Title"] = "Access Denied (403)";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-5 text-center">
        <div class="card-custom bg-white p-5 shadow-sm border">
            <div class="display-1 text-danger mb-3"><i class="bi bi-shield-lock-fill"></i></div>
            <h3 class="fw-bold text-dark mb-2">403 - Access Forbidden</h3>
            <p class="text-muted small mb-4">
                You do not have the required administrative role to view this resource. Role-based security boundary is strictly enforced on the server.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Go to Home</a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-violet">Switch Account</a>
            </div>
        </div>
    </div>
</div>
