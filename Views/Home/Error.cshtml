@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-5 text-center">
        <div class="card-custom bg-white p-5 shadow-sm border">
            <div class="display-1 text-danger mb-3"><i class="bi bi-exclamation-triangle-fill"></i></div>
            <h3 class="fw-bold text-dark mb-2">Unexpected Error</h3>
            <p class="text-muted small mb-4">
                An internal server error occurred while processing your request. The incident has been recorded in our structured application logs.
            </p>

            @if (Model.ShowRequestId)
            {
                <div class="p-2 bg-light rounded-2 font-monospace small text-muted mb-4">
                    <strong>Request ID:</strong> <code>@Model.RequestId</code>
                </div>
            }

            <a asp-controller="Home" asp-action="Index" class="btn btn-violet">Return to Safe Homepage</a>
        </div>
    </div>
</div>
