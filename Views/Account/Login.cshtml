@model HostelComplaintManagementSystem.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Portal Login";
    bool googleConfigured = ViewBag.GoogleConfigured ?? false;
}

<div class="row justify-content-center py-4">
    <div class="col-md-8 col-lg-5">
        <div class="card-custom p-4 p-md-5 bg-white shadow-sm border">
            <div class="text-center mb-4">
                <div class="brand-icon bg-gradient-violet text-white rounded-3 mx-auto d-flex align-items-center justify-content-center mb-2">
                    <i class="bi bi-shield-lock fs-4"></i>
                </div>
                <h3 class="fw-bold text-dark mb-1">HostelCare Login</h3>
                <p class="text-muted small">Sign in with your registered college credentials</p>
            </div>

            <form asp-action="Login" method="post" asp-route-returnUrl="@Model.ReturnUrl">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label small fw-semibold text-secondary"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control border-start-0" id="loginEmail" placeholder="e.g. student@hostelcare.com" autocomplete="username" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label small fw-semibold text-secondary"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-key"></i></span>
                        <input asp-for="Password" class="form-control border-start-0" id="loginPassword" placeholder="••••••••" autocomplete="current-password" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" id="rememberMeCheck" />
                        <label asp-for="RememberMe" class="form-check-label small text-muted" for="rememberMeCheck"></label>
                    </div>
                    <a asp-controller="Complaints" asp-action="Track" class="small text-violet text-decoration-none">Forgot password?</a>
                </div>

                <button type="submit" class="btn btn-violet w-100 py-2 rounded-3 fw-semibold mb-3">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
                </button>
            </form>

            <!-- External Google Login Section (IT5039 Unit VI) -->
            <div class="position-relative text-center my-3">
                <hr class="text-muted opacity-25" />
                <span class="position-absolute top-50 start-50 translate-middle bg-white px-2 small text-muted">or continue with</span>
            </div>

            <form asp-action="ExternalLogin" method="post" class="mb-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="provider" value="Google" />
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                <button type="submit" class="btn btn-outline-secondary w-100 py-2 rounded-3 d-flex align-items-center justify-content-center gap-2 small">
                    <i class="bi bi-google text-danger"></i>
                    <span>Sign in with Google OAuth</span>
                    @if (!googleConfigured)
                    {
                        <span class="badge bg-warning text-dark ms-1" style="font-size:0.65rem;">Config Demo</span>
                    }
                </button>
            </form>

            <!-- Viva / Demo Quick Fill Helper -->
            <div class="bg-light p-3 rounded-3 border">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="small fw-bold text-dark"><i class="bi bi-mortarboard-fill text-violet me-1"></i>Demo Accounts (1-Click Fill)</span>
                    <span class="badge bg-secondary-subtle text-secondary" style="font-size: 0.68rem;">Viva Testing</span>
                </div>
                <div class="d-grid gap-1">
                    <button type="button" class="btn btn-sm btn-outline-primary text-start small py-1" onclick="fillCredentials('student@hostelcare.com', 'Student@123')">
                        <i class="bi bi-person-fill me-1"></i><strong>Student:</strong> student@hostelcare.com / Student@123
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger text-start small py-1" onclick="fillCredentials('warden@hostelcare.com', 'Warden@123')">
                        <i class="bi bi-shield-shaded me-1"></i><strong>Warden:</strong> warden@hostelcare.com / Warden@123
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-success text-start small py-1" onclick="fillCredentials('electrician@hostelcare.com', 'Staff@123')">
                        <i class="bi bi-tools me-1"></i><strong>Staff:</strong> electrician@hostelcare.com / Staff@123
                    </button>
                </div>
            </div>

            <div class="text-center mt-4">
                <span class="small text-muted">Don't have an account?</span>
                <a asp-action="Register" class="small fw-semibold text-violet text-decoration-none ms-1">Register as a Student</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
